<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
    <title>Post</title>
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1>View Post</h1>
        <a role="button" href="/posts">Home</a>
      </div>
      <div>
        <h2><%= post.title %></h2>
        <p><%= post.description %></p>

        <% if (post.creator) { %>
          <p>Posted by: <%= post.creator.uname %></p>
        <% } %>

        <p>Subgroup:
         <a href="/subs/show/<%= post.subgroup %>">
          <%= post.subgroup %>
          </a>
        </p>
        <% if (user) { %>
          <div>
          <form action="/posts/vote/<%= post.id %>" method="post">
           <button type="submit" name="setvoteto" value="1">👍Like</button>
          <button type="submit" name="setvoteto" value="-1">👎dislike</button>
         <button type="submit" name="setvoteto" value="0">Remove Vote</button>
        </form>
        <% } %>
        

        <p>
        Score:
        <%= post.votes.reduce((sum, vote) => sum + vote.value, 0) %>
        </p>
        
        <h3>Comments</h3>

        <% if (post.comments.length === 0) { %>
         <p>No comments yet.</p>
        <% } else { %>
          <% post.comments.forEach(comment => { %>
        <div class="individualcomment">
           <p id="user-comment">
          <%= comment.creator.uname %> says:
          </p>
          <p><%= comment.description %></p>
          <p>
          <%= new Date(comment.timestamp).toLocaleString() %>
          </p>
        </div>
        <% }) %>
        <% } %>

        <% if(user){%>
          <h3>Add a comment</h3>
          <form action="/posts/comment-create/<%= post.id %>" method="post">
            <textarea name="description" id="description" placeholder="Write your comment here"></textarea>
            <button type="submit">Add Comment</button>
          </form>
        <% } %>
        </div>
      </div>
    </main>
  </body>
</html>
