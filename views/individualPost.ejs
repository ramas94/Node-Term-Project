<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
    <title>Post</title>
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1>View Post</h1>
        <a role="button" href="/posts">Home</a>
      </div>
      <div class="individualPost">
        <h2><%= post.title %></h2>
        <p><%= post.description %></p>

        <% if (post.creator) { %>
          <p>Posted by: <%= post.creator.uname %></p>
        <% } %>

        <p>Subgroup:
         <a href="/subs/show/<%= post.subgroup %>">
          <%= post.subgroup %>
          </a>
        </p>
      <div class="authOptions">
           <% if (user && post.creator && user.id === post.creator.id) { %>
        <a class="btn-edit-post" role="button" href="/posts/edit/<%= post.id %>">Edit Post</a>
        <a class="btn-edit-post" id="delete" role="button" href="/posts/deleteconfirm/<%= post.id %>"> 🗑 Delete Post</a>
        <% } %>
       </div>

         <p>
        Score:
        <%= post.votes.reduce((sum, vote) => sum + vote.value, 0) %>
        </p>

        <%
          let currentVote = 0;

           if (user) {
             const foundVote = post.votes.find(vote => vote.user_id === user.id);
             if (foundVote) {
            currentVote = foundVote.value;
                  }
              }
          %>
      
        <% if (user) { %>
          <div class="vote-bar">
            <form action="/posts/vote/<%= post.id %>" method="post">
            <button
              class="voting vote-up <%= currentVote === 1 ? 'active-up' : '' %>"
              type="submit"
              name="setvoteto"
              value="1"
            >
              👍 Like
            </button>

            <button
              class="voting vote-down <%= currentVote === -1 ? 'active-down' : '' %>"
              type="submit"
              name="setvoteto"
              value="-1"
            >
              👎 Dislike
            </button>

            <button
              class="voting vote-reset"
              type="submit"
              name="setvoteto"
              value="0"
            >
              Remove Vote
            </button>
          </form>  
                    
         </div>
        <% } %>

        </div>
        <div>
        <h3>Comments</h3>

        <% if (post.comments.length === 0) { %>
         <p>No comments yet.</p>
        <% } else { %>
          <% post.comments.forEach(comment => { %>
        <div class="individualcomment">
           <p id="user-comment">
          <%= comment.creator.uname %> says:
          </p>
          <p><%= comment.description %></p>
          <p>
          <%= new Date(comment.timestamp).toLocaleString() %>
          </p>
        </div>
        <% }) %>
        <% } %>

        <% if(user){%>
          <h3>Add a comment</h3>
          <form action="/posts/comment-create/<%= post.id %>" method="post">
            <textarea name="description" id="description" placeholder="Write your comment here"></textarea>
            <button type="submit">Add Comment</button>
          </form>
        <% } %>
        </div>
    </main>
  </body>
</html>
