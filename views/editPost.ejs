<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
    <title>EditPost</title>
</head>
<body>
     <main>
      <div class="authOptions">
        <h1>Edit Post</h1>
        <a role="button" href="/posts/show/<%= post.id %>">Back to Post</a>
      </div>

      <form action="/posts/edit/<%= post.id %>" method="post">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= post.title %>" required />

        <label for="link">Link</label>
        <input type="text" id="link" name="link" value="<%= post.link %>" />

        <label for="description">Description</label>
        <textarea id="description" name="description"><%= post.description %></textarea>

        <label for="subgroup">Subgroup</label>
        <input type="text" id="subgroup" name="subgroup" value="<%= post.subgroup %>" required />

        <button type="submit">Save Changes</button>
      </form>
    </main>
    

    
</body>
</html>